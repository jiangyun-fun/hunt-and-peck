<local:ForegroundWindow
    x:Class="HuntAndPeck.Views.OverlayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:HuntAndPeck.Views"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    AllowsTransparency="True"
    Topmost="True"
    ShowActivated="False"
    Loaded="OverlayView_OnLoaded">
    <local:ForegroundWindow.Background>
        <SolidColorBrush Color="Transparent" />
    </local:ForegroundWindow.Background>
    <Grid x:Name="layoutGrid">
        <local:HintCanvas x:Name="hintCanvas" Width="{Binding Bounds.Width}" Height="{Binding Bounds.Height}"
                          HintsSource="{Binding Hints}" Opacity="{Binding LabelOpacity}"
                          PillOpacity="{Binding PillOpacity}" HideInactive="{Binding HideInactive}"
                          GroupView="{Binding GroupView}" GroupBoxesSource="{Binding GroupBoxes}"
                          GroupMatchLength="{Binding MatchLength}" GroupFontSizeText="{Binding GroupFontSize}"
                          ZoneGridCols="{Binding ZoneGridCols}" ZoneGridRows="{Binding ZoneGridRows}">
            <local:HintCanvas.RenderTransform>
                <TranslateTransform X="{Binding OffsetX}" Y="{Binding OffsetY}" />
            </local:HintCanvas.RenderTransform>
        </local:HintCanvas>
        <!-- Display-only: shows the typed prefix. Input arrives via the global
             keyboard hook (not a focused TextBox), so the overlay can stay
             non-activated and not dismiss an open context menu. -->
        <TextBox x:Name="matchBox" Text="{Binding MatchString, Mode=OneWay}" Width="50"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4"
                 Background="Transparent" Foreground="White" IsReadOnly="True" Focusable="False" />
        <!-- Bottom-center status strip (sits over the empty middle of the taskbar).
             The click-mode badge hides while suspended so only SUSPENDED shows.
             Semi-transparent so it never fully obscures content behind it. -->
        <StackPanel x:Name="badgeStrip" Orientation="Horizontal" HorizontalAlignment="Center"
                    VerticalAlignment="Bottom" Margin="0,0,0,8" Opacity="0.75">
            <TextBlock Text="{Binding CurrentModeName}"
                       Background="{Binding CurrentModeBrush}"
                       FontFamily="Helvetica, Arial" FontWeight="Bold" FontSize="14"
                       Foreground="Black" Padding="6,2"
                       Visibility="{Binding ClickModeBadgeVisibility}" />
            <TextBlock Text="{Binding TriggerModeLabel}"
                       FontFamily="Helvetica, Arial" FontWeight="Bold" FontSize="12"
                       Foreground="White" Background="DarkSlateBlue" Padding="6,2"
                       Margin="6,0,0,0" />
            <!-- Current grid layout preset when layout cycling is active (Grid + GridLayouts);
                 Collapsed otherwise so no empty box shows. -->
            <TextBlock Text="{Binding LayoutLabel}"
                       FontFamily="Helvetica, Arial" FontWeight="Bold" FontSize="12"
                       Foreground="White" Background="DarkSlateGray" Padding="6,2"
                       Margin="6,0,0,0" Visibility="{Binding LayoutBadgeVisibility}" />
            <!-- Type-to-zoom zone indicator: "ZONES" while picking, "ZONE n" while a
                 zone is filled. Collapsed when zones are off (no regression). -->
            <TextBlock Text="{Binding ZoneLabel}"
                       FontFamily="Helvetica, Arial" FontWeight="Bold" FontSize="12"
                       Foreground="White" Background="MediumSeaGreen" Padding="6,2"
                       Margin="6,0,0,0" Visibility="{Binding ZoneBadgeVisibility}" />
            <!-- Quadrant indicator (Ctrl+Shift+F1..F4): "Q n/4" while in quadrant mode;
                 plain Tab cycles the four quarters. Collapsed otherwise. -->
            <TextBlock Text="{Binding QuadrantLabel}"
                       FontFamily="Helvetica, Arial" FontWeight="Bold" FontSize="12"
                       Foreground="White" Background="SlateBlue" Padding="6,2"
                       Margin="6,0,0,0" Visibility="{Binding QuadrantBadgeVisibility}" />
            <!-- Snapshot region (<leader>s): "SNAP 1/2" then "SNAP 2/2" while picking corners. -->
            <TextBlock Text="{Binding SnapshotBadgeLabel}"
                       FontFamily="Helvetica, Arial" FontWeight="Bold" FontSize="12"
                       Foreground="White" Background="MediumVioletRed" Padding="6,2"
                       Margin="6,0,0,0" Visibility="{Binding SnapshotBadgeVisibility}" />
            <!-- Text-span selection (<leader>v): "SEL 1/2" then "SEL 2/2" while picking endpoints. -->
            <TextBlock Text="{Binding SelectBadgeLabel}"
                       FontFamily="Helvetica, Arial" FontWeight="Bold" FontSize="12"
                       Foreground="White" Background="SteelBlue" Padding="6,2"
                       Margin="6,0,0,0" Visibility="{Binding SelectBadgeVisibility}" />
        </StackPanel>
        <!-- Leader dispatcher popup (<Space>): centered and transient. Shown only while
             a leader is pending (LeaderMenuVisibility). Lists the key -> action bindings
             (LeaderMenuText). Last child of the Grid so it renders above the canvas. -->
        <Border x:Name="leaderPopup" HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="{Binding LeaderMenuVisibility}"
                Background="#F0151A22" CornerRadius="8" Padding="20,12"
                BorderBrush="#66000000" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="leader" FontFamily="Helvetica, Arial" FontSize="11"
                           Foreground="#9CB4C9" FontWeight="Bold" Margin="0,0,0,6"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding LeaderMenuText}"
                           FontFamily="Consolas, Courier New" FontSize="15" FontWeight="Bold"
                           Foreground="White" TextOptions.TextFormattingMode="Display" />
            </StackPanel>
        </Border>
    </Grid>
</local:ForegroundWindow>
