<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- Max UI Automation tree depth to walk when enumerating hints
             (HintSource=Automation only).
             0 = unbounded (walk the whole window).
             Set to e.g. 5 to walk only the top N levels, which is faster on
             large trees (Chromium apps) at the cost of missing deeply-nested
             controls. Hot-reload: edit, save, press Alt+; . -->
        <add key="MaxEnumerationDepth" value="0" />

        <!-- The overlay shows a grid of labels. Arrow keys MOVE ALL labels
             together (pan the grid) so a label sits on your target. Press Space
             to CYCLE the click mode (Left, Right, Double, Move); the badge at
             top-right shows the current mode. Type the label's 2 chars to fire
             the current mode at its moved position (Move just positions; you
             click manually). The taskbar's buttons are always included too (no
             separate key). Esc cancels. Works on any app, including Chromium. -->

        <!-- Click-mode cycle order (Space advances, wraps). Comma-separated subset
             of Left, Move, Right, Double. Hot-reload. Only the FIRST entry matters now
             (it is the default mode; Space no longer cycles; it opens the leader). -->
        <add key="ClickModeOrder" value="Left,Right,Double,Move" />

        <!-- Two-pick text-span selection (<leader>v) gesture. "ShiftClick" (default):
             pick-1 plain click (anchor), pick-2 Shift+click (extend). "Drag": pick-1
             button-down (held), pick-2 button-up. Hot-reload. ShiftClick holds no
             button while you type the second label (safer); Drag is the fallback where
             Shift+click is remapped by the target app. -->
        <add key="TextSelectMethod" value="ShiftClick" />

        <!-- Leader bindings: press <Space> (the leader) then one key. A key=target list,
             comma/semicolon/pipe-separated. target is a ClickAction name
             (Left/Right/Double/Move/Triple) or a function: Close, Suspend, CycleLayout
             (alias Layout), ToggleDim (alias Dim), Snapshot, SelectText (alias Select).
             Hot-reload. Keys are case-insensitive (uppercased). Default below. -->
        <add key="LeaderBindings" value="l=Left,r=Right,d=Double,t=Triple,m=Move,q=Close,z=Suspend,g=CycleLayout,i=ToggleDim,s=Snapshot,v=SelectText" />

        <!-- Trigger mode (hot-reload). OneClick: the overlay closes after one label
             click. Continuous: the overlay stays up for repeated clicks until Esc or a
             mouse click (Grid only; Automation stays one-shot because its labels go
             stale once you navigate). Press the hotkey again while the overlay is up
             to toggle between the two. Default Continuous. -->
        <add key="OverlayTriggerMode" value="Continuous" />

        <!-- Main overlay hotkey. HotkeyKey is a System.Windows.Forms.Keys name
             (e.g. M, F, Space, OemSemicolon, D1). HotkeyModifier is a comma-separated
             list of KeyModifier flags (Alt, Control, Shift, Windows). Read once at
             startup: edit, save, then RESTART hap.exe to apply.
             NOTE: avoid Alt here. Pressing Alt (even as part of a chord) dismisses an
             open context menu, so a Ctrl+Shift+Alt+... hotkey would close the very menu
             you are trying to label-click. Default Ctrl+Shift+M. -->
        <add key="HotkeyKey" value="M" />
        <add key="HotkeyModifier" value="Control,Shift" />

        <!-- Quadrant hotkeys (read once at startup; restart to apply). Four chords that
             open the overlay scoped to one screen quadrant (a dense grid covering just
             that quarter, full-screen overlay): F1=top-left, F2=top-right, F3=bottom-left,
             F4=bottom-right. The overlay actually holds all four quadrants and starts on
             the pressed one, so plain Tab/Shift+Tab cycle the quarters (badge "Q n/4");
             Ctrl+Tab/Ctrl+Shift+Tab/Win+Tab still pass through. QuadrantHotkeyKeys is 4
             Keys names; QuadrantHotkeyModifier is the shared modifier. Default
             Ctrl+Shift+F1..F4. -->
        <add key="QuadrantHotkeyKeys" value="F1,F2,F3,F4" />
        <add key="QuadrantHotkeyModifier" value="Control,Shift" />

        <!-- Macro picker hotkey (read once at startup; restart to apply). Opens a small
             palette of macros; type a macro's single-char key to run it. Default Ctrl+Shift+;
             (OemSemicolon, no Alt). Macros live in %APPDATA%\hap\macros.json (NOT in git). -->
        <add key="MacroHotkeyKey" value="OemSemicolon" />
        <add key="MacroHotkeyModifier" value="Control,Shift" />

        <!-- Where hints come from.
             "Automation" enumerates the target window's real controls (slow on
             large trees, but precise).
             "Grid" generates an instant grid of cursor-jump points covering the
             window (no enumeration). Type a label to move the cursor there, then
             nudge to click. Works on any app, including Chromium. -->
        <add key="HintSource" value="Grid" />

        <!-- What area the overlay covers (Grid and Automation): "Screen" = the full
             monitor the foreground window is on, so labels fill the screen regardless
             of window size; "Window" = the foreground window rect (the previous
             behavior). Hot-reload. -->
        <add key="HintBoundsSource" value="Screen" />

        <!-- Grid inset: pixels of margin between the grid and each window edge, so
             labels avoid the title bar / screen edge. Hot-reload. -->
        <add key="GridInset" value="10" />

        <!-- Dense regions (HintSource=Grid only): comma-separated regions that get a
             dense cluster of cursor-jump points. Options: Left, Top, Right, Bottom
             (full edge strips), TL, TR, BL, BR (corner squares), Center (sparse
             interior). Default: dense left + top edges and right corners, sparse center
             (sidebar left, tabs top, controls in right corners). Use just "Center" for a
             uniform sparse grid. Hot-reload. -->
        <add key="GridDenseRegions" value="Left,Top,TR,BR,Center" />

        <!-- Edge band: thickness (% of window per edge) of the dense strips/corners. -->
        <add key="GridEdgeBandPercent" value="15" />

        <!-- Point spacing (px): GridEdgeStep in dense regions, GridCenterStep in the
             sparse center. Smaller = more points / finer jumps. These drive layout 1
             below (and the no-GridLayouts fallback). Hot-reload. -->
        <add key="GridEdgeStep" value="30" />
        <add key="GridCenterStep" value="50" />

        <!-- Multiple grid layouts (HintSource=Grid only): a list of geometry presets you
             can cycle LIVE with the `;` key while the overlay is up. Layouts are
             separated by `||`; each layout's fields by `|`, in this order:
               edgeStep | centerStep | inset | edgeBandPercent | denseRegions
             (denseRegions may contain commas, e.g. Left,Top,TR,BR,Center). Layout 2 (the
             uniform grid) is the default; `;` advances and wraps (badge shows e.g. L2/2).
             The active preset is remembered across Esc/reopen AND a full restart
             (ActiveLayout). Omit this key (or leave it blank) to use the five knobs above
             instead, i.e. the previous single-layout behavior. Hot-reload. -->
        <add key="GridLayouts" value="30|50|10|15|Left,Top,TR,BR,Center || 40|40|10|0|Center" />

        <!-- The active GridLayouts preset index (0-based), rewritten by the `;` key so the
             choice survives a restart. Default 1 = layout 2 (the uniform grid); it wraps
             to the preset count. -->
        <add key="ActiveLayout" value="1" />

        <!-- Characters used to build hint labels. Default is A-Z (26 letters = 676
             two-char labels, easy to recognize). Punctuation (,./;'[]\) is also
             supported: add any of them here to make them typeable labels. Digits are
             RESERVED for overlay functions (1=close, 2=suspend, 3=cycle layout), so do
             NOT include 0-9 here (a generated digit label could never be typed).
             Hot-reload. -->
        <add key="HintCharacters" value="ABCDEFGHIJKLMNOPQRSTUVWXYZ" />

        <!-- Hint label font size (px). Hot-reload. Overrides the Options-dialog
             size when set. Larger labels may overlap on dense grids; raise
             GridEdgeStep for more spacing. -->
        <add key="HintFontSize" value="10" />

        <!-- Hint label font family. Hot-reload. Default "JetBrains Mono NL", bundled in
             the assembly (pack URI) so it renders even if not installed; the NL cut has
             no ligatures, so punctuation label pairs render literally. Set to any
             installed family to override (e.g. Consolas); comma fallbacks allowed. -->
        <add key="HintFontFamily" value="JetBrains Mono NL" />

        <!-- Pill fill opacity (percent, 0-100; default 80). Hot-reload. Softens the
             vivid yellow so background peeks through; the label TEXT stays fully
             opaque (crisp) regardless. 100 = solid, lower = more see-through. -->
        <add key="HintPillOpacity" value="80" />

        <!-- Dimmed-label opacity (percent, 0-100; default 20). Hot-reload. Opacity used
             when you press backtick to dim labels so the text behind is readable. The
             label text dims with the pill here (canvas-wide), unlike base mode. -->
        <add key="HintDimOpacity" value="20" />

        <!-- Overlay idle auto-close (seconds, hot-reload). If >0, the overlay closes after
             this many seconds with no key/click activity (any input resets the clock);
             skipped while suspended. 0 = off (never auto-close). Default 0. -->
        <add key="OverlayAutoCloseSec" value="0" />

        <!-- Hide non-matching labels (hot-reload). When true, after you type the first char
             of a 2-char label, labels that do not match disappear (not just dim). Default true. -->
        <add key="HideNonMatchingLabels" value="true" />

        <!-- Set to "true" to log overlay enum+merge and render timings to
             %TEMP%\hap-timing.log on each trigger (diagnostic). Off by default. -->
        <add key="TimingLogEnabled" value="false" />

        <!-- What the dedicated arrow cluster does while the overlay is up.
             Passthrough (default): arrows go to the app beneath (Excel/list/editor
             focus nav). Pan (legacy): arrows pan all labels. Either way the hjkl
             chords pan: Shift+hjkl = large step, Ctrl+Shift+hjkl = small step.
             Hot-reload. -->
        <add key="ArrowKeyBehavior" value="Passthrough" />

        <!-- Label-pan (nudge): 3 tiers, each Shift+<row>. Plain row keys still type labels.
             Each tier step is "X,Y" px (X for the left/right keys, Y for the up/down keys,
             so the two axes can differ) OR "auto" (= the current zone's cellW/cellH, so one
             Large nudge traverses exactly one zone). Defaults: Small 3,3 ; Medium 15,15 ;
             Large auto. NudgeKeys* are 4 Keys names in L,D,U,R order. Dedicated arrows (when
             ArrowKeyBehavior=Pan) use Medium (plain) / Large (Shift). Pans all labels
             together. Hot-reload. -->
        <add key="NudgeStepSmall" value="3,3" />
        <add key="NudgeStepMedium" value="15,15" />
        <add key="NudgeStepLarge" value="auto" />
        <add key="NudgeKeysSmall" value="M,Oemcomma,Oemperiod,Oem2" />
        <add key="NudgeKeysMedium" value="H,J,K,L" />
        <add key="NudgeKeysLarge" value="U,I,O,P" />

        <!-- Type-to-zoom zones (HintSource=Grid + HintBoundsSource=Screen only).
             When ZoneZoomEnabled is true, the overlay opens with a cols x rows grid
             of large 1-char zone labels over the current monitor; type a zone label
             to drill into that zone's sub-rectangle, which is then filled with the
             fine grid. Each zone holds ~1/(cols*rows) of the monitor's points, so it
             stays far under the HintCharacters^2 cap -> the configured fine step
             survives uncapped (dense labels) AND more labels are 1-char (short).
             Requires cols*rows <= the number of HintCharacters (so every zone gets a
             single-char label); otherwise zones are skipped. Tab monitor-cycling is
             disabled in zone mode (the foreground monitor only). Hot-reload. -->
        <add key="ZoneZoomEnabled" value="false" />
        <add key="ZoneCols" value="3" />
        <add key="ZoneRows" value="3" />
        <add key="ZoneFontSize" value="20" />
        <!-- In-zone uniform grid step (px). Lower = more/denser labels in the zone. Default 30. -->
        <add key="ZoneGridStep" value="30" />
        <!-- Zone-filled lens size in px (the fine-grid window centered on the zone center).
             0 = auto (= the monitor's auto cell size). Set both equal (e.g. 500 and 500) so a
             single Large nudge traverses exactly one zone in both axes. Default 0 (auto). -->
        <add key="ZoneWidth" value="0" />
        <add key="ZoneHeight" value="0" />
        <!-- In Continuous mode, after firing a label in a zone: false (default) =
             stay in the zone for repeated nearby clicks; true = return to the 9-label
             zone-pick view after every click. -->
        <add key="ZoneZoomReturnToPickOnFire" value="false" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5.1" />
    </startup>
</configuration>
